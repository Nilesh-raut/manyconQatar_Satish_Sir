<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<script src="https://static.zohocdn.com/creator/widgets/version/1.0/widgetsdk-min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif;}
body{background:#f4f6f9;padding:15px;}
/* Full-width horizontal strip with items pushed to the right side corner */
.action-strip {
  width: 100%;
  background: white;
  padding: 15px 20px;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  justify-content: flex-end; /* This aligns content to the right side */
}
.loading{font-size:15px;color:#2563eb;font-weight:bold;margin-left: auto;}
.no-records{color:#ff5722;font-size:15px;font-weight:bold;margin-left: auto;}
.btn-green{background:#16a34a;color:white;border:none;padding:10px 22px;border-radius:6px;cursor:pointer;font-size:14px;font-weight:bold;transition:0.3s;margin-left: auto;}
.btn-green:hover{background:#15803d;}
.btn-green:disabled{opacity:0.5;cursor:not-allowed;}
</style>
</head>
<body>

<div class="action-strip" id="mainContainer">
  <div class="loading">Processing Timesheet Data...</div>
</div>

<script>

var _rows = [];
var _reportTitle = "";

function parseDate(str){
  if(!str) return null;
  const parts = str.split("-");
  if(parts.length !== 3) return null;
  return new Date(parts[1]+" "+parts[0]+", "+parts[2]);
}

function parseWorkTiming(dv){
  const parts = dv.split("^#^").map(s => s.trim());
  return {
    employees:  parts[1] || "",
    inTime:     parts[2] || "",
    outTime:    parts[3] || "",
    totalHours: parts[4] || "",
    normalDuty: parts[5] || "",
    breakHours: parts[6] || "",
    overTime:   parts[7] || ""
  };
}

function extractEmployeeNames(empStr){
  if(!empStr) return [];
  return empStr.split(",").map(s => {
    const parts = s.trim().split(" - ");
    return parts.length >= 2 ? parts.slice(1).join(" - ").trim() : s.trim();
  });
}

function extractEmployeeIDs(empStr){
  if(!empStr) return [];
  return empStr.split(",").map(s => {
    const parts = s.trim().split(" - ");
    return parts[0] ? parts[0].trim() : "";
  });
}

async function getAllRecords(reportName){
  let all = [];
  let page = 1;
  let hasMore = true;
  while(hasMore){
    const res = await ZOHO.CREATOR.API.getAllRecords({
      appName:"employee-self-service-portal",
      reportName:reportName,
      page:page,
      pageSize:200
    });
    const records = res.data || [];
    all.push(...records);
    if(records.length < 200) hasMore = false;
    else page++;
  }
  return all;
}

function buildRowsFromDriverRecord(rec){
  return [{
    employeeName: rec.Employee_Name ? (rec.Employee_Name.display_value || "") : "",
    workDate:     rec.work_date || "",
    checkIn:      rec.Check_In  || "",
    checkOut:     rec.Check_Out || "",
    totalHours:   rec.Total_Hours_SL || "",
    normalDuty:   "08:00",
    breakHours:   "01:00",
    overTime:     rec.Over_Time_SL || ""
  }];
}

function buildRowsFromSiteWorkerRecord(rec){
  const rows = [];
  const wts = rec.Work_Timings || [];
  for(const wt of wts){
    const dv = wt.display_value || "";
    if(!dv) continue;
    const parsed   = parseWorkTiming(dv);
    const empNames = extractEmployeeNames(parsed.employees);
    for(let i = 0; i < empNames.length; i++){
      rows.push({
        employeeName: empNames[i] || parsed.employees,
        workDate:     rec.work_date || "",
        checkIn:      parsed.inTime,
        checkOut:     parsed.outTime,
        totalHours:   parsed.totalHours,
        normalDuty:   parsed.normalDuty,
        breakHours:   parsed.breakHours,
        overTime:     parsed.overTime
      });
    }
  }
  return rows;
}

function downloadExcel(){
  if(!_rows || _rows.length === 0){
    alert("No data to export.");
    return;
  }

  const btn = document.getElementById("excelBtn");
  if(btn){
    btn.disabled = true;
    btn.textContent = "Exporting...";
  }

  try{
    const wb = XLSX.utils.book_new();
    const sheetData = [];

    sheetData.push([
      "Employee Name",
      "Work Date",
      "Check In",
      "Check Out",
      "Total Hours",
      "Normal Duty",
      "Break Hours",
      "Over Time"
    ]);

    for(const r of _rows){
      sheetData.push([
        r.employeeName,
        r.workDate,
        r.checkIn,
        r.checkOut,
        r.totalHours,
        r.normalDuty,
        r.breakHours,
        r.overTime
      ]);
    }

    const ws = XLSX.utils.aoa_to_sheet(sheetData);

    ws["!cols"] = [
      {wch:32}, {wch:15}, {wch:15}, {wch:15}, {wch:14}, {wch:14}, {wch:14}, {wch:12}
    ];

    XLSX.utils.book_append_sheet(wb, ws, "Timesheet");

    const safeTitle = (_reportTitle || "Timesheet_Report").replace(/[^a-z0-9]/gi,"_");
    XLSX.writeFile(wb, safeTitle + ".xlsx");

  } catch(err){
    console.error(err);
    alert("Export failed: " + err);
  }

  if(btn){
    btn.disabled = false;
    btn.textContent = "Download Excel";
  }
}

function renderReport(title, employeeInfo, rows){
  _rows = rows;
  _reportTitle = title;

  const container = document.getElementById("mainContainer");

  if(rows.length === 0){
    container.innerHTML = `<div class="no-records">NO RECORDS FOUND TO DOWNLOAD</div>`;
    return;
  }

  // Renders button positioned cleanly inside the layout strip pointing right
  container.innerHTML = `
    <button class="btn-green" id="excelBtn" onclick="downloadExcel()">Download Excel</button>
  `;
}

ZOHO.CREATOR.init().then(async function(){
  try{
    const params     = ZOHO.CREATOR.UTIL.getQueryParams();
    const searchType = params.search_type    || "";
    const employeeId = params.employee_id    || "";
    const dateVar    = params.date_var       || "";
    const weekFrom   = params.week_from_date || "";
    const weekTo     = params.week_to_date   || "";
    const monthVal   = params.month_val      || "";
    const yearVal    = params.year_val       || "";
    const siteId     = params.site_id        || "";

    const title = (searchType || "Month Wise Search") + " Timesheet Report";

    const allTimesheets = await getAllRecords("All_Timesheets");

    let employeeInfo = null;
    let employeeCode = "";
    let isDriver     = false;

    if(employeeId){
      const allEmployees = await getAllRecords("Employee_Master_Report");
      const emp = allEmployees.find(e => String(e.ID) === String(employeeId));
      if(emp){
        const desig  = emp.designation ? (emp.designation.display_value || "") : "";
        isDriver     = desig === "Driver";
        employeeCode = emp.Employee_ID || "";
        employeeInfo = {
          name:        emp.Employee_Full_Name || "",
          empId:       emp.Employee_ID || "",
          designation: desig
        };
      }
    }

    let filtered = [];

    if(searchType === "Employee Wise Search" && employeeId){
      if(isDriver){
        filtered = allTimesheets.filter(rec =>
          rec.Timesheet_For === "Drivers" &&
          rec.Employee_Name &&
          String(rec.Employee_Name.ID) === String(employeeId)
        );
      } else {
        filtered = allTimesheets.filter(rec => {
          if(rec.Timesheet_For !== "Site Workers") return false;
          return (rec.Work_Timings || []).some(wt => {
            const parsed = parseWorkTiming(wt.display_value || "");
            return extractEmployeeIDs(parsed.employees).some(id => id.trim() === employeeCode.trim());
          });
        });
      }
    }
    else if(searchType === "Day Wise Search"){
      if(employeeId && isDriver){
        filtered = allTimesheets.filter(rec =>
          rec.Timesheet_For === "Drivers" &&
          rec.Employee_Name &&
          String(rec.Employee_Name.ID) === String(employeeId) &&
          rec.work_date === dateVar
        );
      } else {
        filtered = allTimesheets.filter(rec => rec.work_date === dateVar);
      }
    }
    else if(searchType === "Week Wise Search"){
      const fromDate = parseDate(weekFrom);
      const toDate   = parseDate(weekTo);
      if(employeeId && isDriver){
        filtered = allTimesheets.filter(rec => {
          if(rec.Timesheet_For !== "Drivers") return false;
          if(!rec.Employee_Name || String(rec.Employee_Name.ID) !== String(employeeId)) return false;
          const d = parseDate(rec.work_date);
          return d && fromDate && toDate && d >= fromDate && d <= toDate;
        });
      } else {
        filtered = allTimesheets.filter(rec => {
          const d = parseDate(rec.work_date);
          return d && fromDate && toDate && d >= fromDate && d <= toDate;
        });
      }
    }
    else if(searchType === "Site Wise Search"){
      filtered = allTimesheets.filter(rec =>
        rec.Site_Name &&
        String(rec.Site_Name.ID) === String(siteId)
      );
    }
    else {
      if(employeeId && isDriver){
        filtered = allTimesheets.filter(rec =>
          rec.Timesheet_For === "Drivers" &&
          rec.Employee_Name &&
          String(rec.Employee_Name.ID) === String(employeeId) &&
          rec.Month_field === monthVal &&
          rec.Year_field  === yearVal
        );
      } else {
        filtered = allTimesheets.filter(rec =>
          rec.Month_field === monthVal &&
          rec.Year_field  === yearVal
        );
      }
    }

    let rows = [];

    for(const rec of filtered){
      if(rec.Timesheet_For === "Drivers"){
        if(!employeeId || (rec.Employee_Name && String(rec.Employee_Name.ID) === String(employeeId))){
          rows.push(...buildRowsFromDriverRecord(rec));
        }
      } else {
        if(employeeId && !isDriver){
          const wts = rec.Work_Timings || [];
          for(const wt of wts){
            const dv = wt.display_value || "";
            if(!dv) continue;
            const parsed   = parseWorkTiming(dv);
            const empIds   = extractEmployeeIDs(parsed.employees);
            const empNames = extractEmployeeNames(parsed.employees);
            for(let i = 0; i < empIds.length; i++){
              if(empIds[i].trim() === employeeCode.trim()){
                rows.push({
                  employeeName: empNames[i] || parsed.employees,
                  workDate:     rec.work_date || "",
                  checkIn:      parsed.inTime,
                  checkOut:     parsed.outTime,
                  totalHours:   parsed.totalHours,
                  normalDuty:   parsed.normalDuty,
                  breakHours:   parsed.breakHours,
                  overTime:     parsed.overTime
                });
              }
            }
          }
        } else {
          rows.push(...buildRowsFromSiteWorkerRecord(rec));
        }
      }
    }

    rows.sort((a,b) => {
      const da = parseDate(a.workDate);
      const db = parseDate(b.workDate);
      if(!da||!db) return 0;
      return da - db;
    });

    renderReport(title, employeeInfo, rows);

  } catch(err){
    console.error(err);
    document.getElementById("mainContainer").innerHTML =
      `<div class="no-records">Error loading report: ${err}</div>`;
  }
});
</script>
</body>
</html>
