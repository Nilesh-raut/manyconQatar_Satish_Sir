/* ---- 1. ROAD MARKING BOQ ---- */
function buildRoadMarkingPDF(record) {

    const items = record.Subform_1 || [];

    const grouped = {};
    items.forEach(item => {
        const culvert = item.Select_Culvert || "OTHERS";
        if (!grouped[culvert]) grouped[culvert] = [];
        grouped[culvert].push(item);
    });

    let grandTotal = 0;
    items.forEach(item => { grandTotal += Number(item.TOTAL_PRICE_QAR || 0); });

    let rows = "";
    Object.keys(grouped).forEach(culvert => {
        rows += `<tr class="culvertRow"><td colspan="6">${culvert}</td></tr>`;
        grouped[culvert].forEach(row => {
            rows += `
                <tr>
                    <td class="center" style="width:5%;">${row.LinkingModule4_Serial_Number || ""}</td>
                    <td style="width:53%;">${row.DESCRIPTION || ""}</td>
                    <td class="center" style="width:10%;">${row.UOM || ""}</td>
                    <td class="center" style="width:7%;">${row.QTY || ""}</td>
                    <td class="right" style="width:12%;">${Number(row.UNIT_PRICE_QAR || 0).toFixed(2)}</td>
                    <td class="right" style="width:13%;">${Number(row.TOTAL_PRICE_QAR || 0).toFixed(2)}</td>
                </tr>`;
        });
    });

    return {
        title: `ROAD MARKING BOQ - ${record.DRAIEH_CONTRACTING}`,
        filename: "ROAD MARKING BOQ.pdf",
        html: `
        <table>
            <colgroup>
                <col style="width:55px">
                <col style="width:250px">
                <col><col><col><col>
            </colgroup>
            <thead>
                <tr><td colspan="6" class="titleRow">ROAD MARKING BOQ - ${record.DRAIEH_CONTRACTING}</td></tr>
                <tr><td colspan="6" class="projectRow">PROJECT: ${record.PROJECT}</td></tr>
                <tr class="headerRow">
                    <th style="width:5%;">Sl.NO.</th>
                    <th style="width:53%;">DESCRIPTION</th>
                    <th style="width:10%;">UOM</th>
                    <th style="width:7%;">QTY</th>
                    <th style="width:12%;">UNIT PRICE (QAR)</th>
                    <th style="width:13%;">TOTAL PRICE (QAR)</th>
                </tr>
            </thead>
            <tbody>${rows}</tbody>
            <tfoot>
                <tr class="totalRow">
                    <td colspan="5" class="right">TOTAL AMOUNT (QAR)</td>
                    <td class="right">${grandTotal.toFixed(2)}</td>
                </tr>
                <tr class="noteRow"><td colspan="6">NOTE : ALL QUANTITIES ARE RE-MEASURABLE AS PER THE SITE CONDITION</td></tr>
                <tr class="noteRow"><td colspan="6">NOTE : HEATING SYSTEM IS PROPANE NOT LPG</td></tr>
            </tfoot>
        </table>`
    };
}

/* ---- 2. FIRE PROOFING BOQ ---- */
function buildFireProofingPDF(record) {

    const items = record.BOQ_Fire_Proofing || [];

    /* Group by Main_Category (COLUMN / BEAM etc.) */
    const grouped = {};
    items.forEach(item => {
        const cat = item.Main_Category || "OTHERS";
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(item);
    });

    /* Totals per category and grand */
    let grandTotal = 0;
    const catTotals = {};
    items.forEach(item => {
        const cat = item.Main_Category || "OTHERS";
        const sqm = Number(item.Total_SQM || 0);
        catTotals[cat] = (catTotals[cat] || 0) + sqm;
        grandTotal += sqm;
    });

    let rows = "";
    Object.keys(grouped).forEach(cat => {
        rows += `<tr class="sectionRow"><td colspan="9">${cat}</td></tr>`;
        grouped[cat].forEach(row => {
            rows += `
                <tr>
                    <td class="center">${row.LinkingModule4_Serial_Number || ""}</td>
                    <td>${row.FLOOR_NAME_STEEL_PROOFING_BOQ || ""}</td>
                    <td class="center">${row.Size || ""}</td>
                    <td class="center">${row.Exposure || ""}</td>
                    <td class="center">${row.Length_Height_Per_Structure || ""}</td>
                    <td class="center">${row.Nos || ""}</td>
                    <td class="center">${row.Total_Length || ""}</td>
                    <td class="center">${Number(row.SQM_Per_LM || 0).toFixed(2)}</td>
                    <td class="right">${Number(row.Total_SQM || 0).toFixed(3)}</td>
                </tr>`;
        });
        rows += `
            <tr class="subTotalRow">
                <td colspan="8" class="right">TOTAL SQM (${cat})</td>
                <td class="right">${(catTotals[cat] || 0).toFixed(3)}</td>
            </tr>`;
    });

    return {
        title: `STEEL PROOFING BOQ - ${record.DRAIEH_CONTRACTING}`,
        filename: "FIRE PROOFING BOQ.pdf",
        html: `
        <table>
            <thead>
                <tr><td colspan="9" class="titleRow">STEEL PROOFING BOQ - ${record.DRAIEH_CONTRACTING}</td></tr>
                <tr><td colspan="9" class="projectRow">PROJECT: ${record.PROJECT}</td></tr>
                <tr class="headerRow">
                    <th style="width:6%;">SI.NO.</th>
                    <th style="width:14%;">FLOOR NAME</th>
                    <th style="width:18%;">SIZE</th>
                    <th style="width:8%;">EXPOSURE</th>
                    <th style="width:14%;">LENGTH / HEIGHT PER STRUCTURE</th>
                    <th style="width:6%;">NOS</th>
                    <th style="width:12%;">TOTAL LENGTH</th>
                    <th style="width:10%;">SQM PER LM</th>
                    <th style="width:12%;">TOTAL SQM</th>
                </tr>
            </thead>
            <tbody>${rows}</tbody>
            <tfoot>
                <tr class="totalRow">
                    <td colspan="8" class="right">GRAND TOTAL SQM</td>
                    <td class="right">${grandTotal.toFixed(3)}</td>
                </tr>
                <tr class="noteRow"><td colspan="9">NOTE : ALL QUANTITIES ARE RE-MEASURABLE AS PER THE SITE CONDITION</td></tr>
            </tfoot>
        </table>`
    };
}

