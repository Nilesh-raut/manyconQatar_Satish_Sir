/* ================================================= */
/* ROUTER — picks the right builder by dropdown       */
/* ================================================= */

function getBuilder(selectValue) {
    const v = (selectValue || "").trim().toUpperCase();

    if (v.includes("ROAD MARKING"))           return buildRoadMarkingPDF;
    if (v.includes("FIRE") ||
        v.includes("PROOFING"))               return buildFireProofingPDF;
    if (v.includes("GRP"))                    return buildGRPLiningPDF;
    if (v.includes("HEAD OF WALL"))           return buildHeadOfWallPDF;
    if (v.includes("PENETRATION"))            return buildPenetrationPDF;
    if (v.includes("RM") ||
        v.includes("EPOXY"))                  return buildRMEpoxyPDF;
    if (v.includes("SIGNAGE") ||
        v.includes("SIGNAGES"))               return buildSignagePDF;

    /* default fallback */
    return buildRoadMarkingPDF;
}

/* ================================================= */
/* MAIN                                              */
/* ================================================= */

ZOHO.embeddedApp.on("PageLoad", async function(data) {

try {

    ZOHO.CRM.UI.Resize({ height: "900", width: "1200" });

    /* ---- fetch record ---- */
    const recordId = Array.isArray(data.EntityId) ? data.EntityId[0] : data.EntityId;

    const response = await ZOHO.CRM.API.getRecord({
        Entity: "BOQ",
        RecordID: recordId
    });

    const record = response.data[0];
    console.log("Record:", record);

    /* ---- pick builder from dropdown ---- */
    const selectValue = record.Select_subfrom || "";
    const builder     = getBuilder(selectValue);
    const built       = builder(record);

    /* ---- inject HTML ---- */
    document.getElementById("pdfArea").innerHTML = `
        <img class="watermark" src="${watermarkImg}">
        <div class="content">
            ${built.html}
            <img class="seal" src="${sealImg}">
        </div>`;

    /* ---- generate PDF ---- */
    setTimeout(() => {
        html2pdf()
            .set({
                margin: [5, 5, 5, 5],
                filename: built.filename,
                image: { type: "jpeg", quality: 1 },
                html2canvas: {
                    scale: 2,
                    useCORS: true,
                    scrollY: 0
                },
                jsPDF: {
                    unit: "mm",
                    format: "a4",
                    orientation: "portrait"
                },
                pagebreak: {
                    mode: ["avoid-all", "css", "legacy"]
                }
            })
            .from(document.getElementById("pdfArea"))
            .save();
    }, 1000);

} catch (error) {
    console.error(error);
    alert("ERROR : " + JSON.stringify(error));
}

});

ZOHO.embeddedApp.init();

</script>

