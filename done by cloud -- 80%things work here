/* ---- 6. RM & EPOXY BOQ ---- */
function buildRMEpoxyPDF(record) {

    const items = record.all_Subform || [];

    /* Split into EPOXY section and ROAD MARKING section by Work_Type */
    const epoxyItems  = items.filter(i => (i.Work_Type || "").toUpperCase().includes("EPOXY"));
    const rmItems     = items.filter(i => (i.Work_Type || "").toUpperCase().includes("ROAD") || (i.Work_Type || "").toUpperCase().includes("MARKING"));
    const otherItems  = items.filter(i => {
        const wt = (i.Work_Type || "").toUpperCase();
        return !wt.includes("EPOXY") && !wt.includes("ROAD") && !wt.includes("MARKING");
    });

    /* Combine: epoxy first, then road marking, then others */
    const allSections = [];
    if (epoxyItems.length)  allSections.push({ label: "EPOXY WORKS",        rows: epoxyItems });
    if (rmItems.length)     allSections.push({ label: "ROAD MARKING WORKS", rows: rmItems    });
    if (otherItems.length)  allSections.push({ label: "OTHERS",             rows: otherItems });
    /* Fallback: if no Work_Type was set, just show all items flat */
    if (!allSections.length) allSections.push({ label: "", rows: items });

    let grandTotal = 0;
    items.forEach(item => { grandTotal += Number(item.TOTAL_PRICE_QAR || 0); });

    let rows = "";
    allSections.forEach(sec => {
        if (sec.label) {
            rows += `<tr class="sectionRow"><td colspan="6">${sec.label}</td></tr>`;
        }
        /* Sub-group by Area_section within each section */
        const areaGroups = {};
        sec.rows.forEach(item => {
            const area = item.Area_section || "";
            if (!areaGroups[area]) areaGroups[area] = [];
            areaGroups[area].push(item);
        });

        let secTotal = 0;
        Object.keys(areaGroups).forEach(area => {
            if (area) rows += `<tr class="subSectionRow"><td colspan="6">&nbsp;&nbsp;&nbsp;${area}</td></tr>`;
            areaGroups[area].forEach(row => {
                const tot = Number(row.TOTAL_PRICE_QAR || 0);
                secTotal += tot;
                rows += `
                    <tr>
                        <td class="center" style="width:6%;">${row.LinkingModule5_Serial_Number || ""}</td>
                        <td style="width:48%;">${row.DESCRIPTION || ""}</td>
                        <td class="center" style="width:8%;">${row.UOM || ""}</td>
                        <td class="center" style="width:8%;">${row.QTY || ""}</td>
                        <td class="right" style="width:15%;">${Number(row.UNIT_PRICE_QAR || 0).toFixed(2)}</td>
                        <td class="right" style="width:15%;">${tot.toFixed(2)}</td>
                    </tr>`;
            });
        });
        if (sec.label) {
            rows += `
                <tr class="subTotalRow">
                    <td colspan="5" class="right">TOTAL (${sec.label})</td>
                    <td class="right">${secTotal.toFixed(2)}</td>
                </tr>`;
        }
    });

    return {
        title: `RM & EPOXY BOQ - ${record.DRAIEH_CONTRACTING}`,
        filename: "RM & EPOXY BOQ.pdf",
        html: `
        <table>
            <thead>
                <tr><td colspan="6" class="titleRow">RM &amp; EPOXY BOQ - ${record.DRAIEH_CONTRACTING}</td></tr>
                <tr><td colspan="6" class="projectRow">PROJECT: ${record.PROJECT}</td></tr>
                <tr class="headerRow">
                    <th style="width:6%;">SI.NO.</th>
                    <th style="width:48%;">DESCRIPTION</th>
                    <th style="width:8%;">UOM</th>
                    <th style="width:8%;">QTY</th>
                    <th style="width:15%;">UNIT PRICE (QAR)</th>
                    <th style="width:15%;">TOTAL PRICE (QAR)</th>
                </tr>
            </thead>
            <tbody>${rows}</tbody>
            <tfoot>
                <tr class="totalRow">
                    <td colspan="5" class="right">TOTAL AMOUNT (QAR)</td>
                    <td class="right">${grandTotal.toFixed(2)}</td>
                </tr>
                <tr class="noteRow"><td colspan="6">NOTE : ALL QUANTITIES ARE RE-MEASURABLE AS PER THE SITE CONDITION</td></tr>
            </tfoot>
        </table>`
    };
}

