/* ---- 7. FIRE PROOFING BOQ ---- */
/* ---- 7. FIRE PROOFING BOQ ---- */
/* ---- 7. FIRE PROOFING BOQ ---- */
function buildFireProofingPDF(record) {

    const items = record.BOQ_Fire_Proofing || [];

    /* GROUP BY MAIN CATEGORY */
    const grouped = {};

    items.forEach(item => {

        const cat = item.Main_Category || "OTHERS";

        if (!grouped[cat]) {
            grouped[cat] = [];
        }

        grouped[cat].push(item);
    });

    /* CATEGORY TOTALS */
    const catTotals = {};
    let grandTotal = 0;

    items.forEach(item => {

        const cat = item.Main_Category || "OTHERS";
        const sqm = Number(item.Total_SQM || 0);

        catTotals[cat] = (catTotals[cat] || 0) + sqm;
        grandTotal += sqm;
    });

    let rows = "";

    Object.keys(grouped).forEach(cat => {

        rows += `
        <tr class="sectionRow">
            <td colspan="9" style="text-align:center;font-weight:bold;">
                ${cat}
            </td>
        </tr>`;

        /* FLOOR GROUPING INSIDE CATEGORY */
        const floorGroups = {};

        grouped[cat].forEach(item => {

            const floor = item.FLOOR_NAME_STEEL_PROOFING_BOQ || "";

            if (!floorGroups[floor]) {
                floorGroups[floor] = [];
            }

            floorGroups[floor].push(item);
        });

        Object.keys(floorGroups).forEach(floor => {

            const floorRows = floorGroups[floor];

            floorRows.forEach((row, index) => {

                rows += `<tr>`;

                rows += `
                    <td class="center">
                        ${row.LinkingModule4_Serial_Number || ""}
                    </td>`;

                /* FLOOR NAME MERGED */
                if (index === 0) {

                    rows += `
                    <td class="center"
                        rowspan="${floorRows.length}"
                        style="
                            vertical-align:middle;
                            text-align:center;
                            font-weight:bold;
                        ">
                        ${floor}
                    </td>`;
                }

                rows += `
                    <td class="center">
                        ${row.Size || ""}
                    </td>

                    <td class="center">
                        ${row.Exposure || ""}
                    </td>

                    <td class="center">
                        ${row.Length_Height_Per_Structure || ""}
                    </td>

                    <td class="center">
                        ${row.Nos || ""}
                    </td>

                    <td class="center">
                        ${row.Total_Length || ""}
                    </td>

                    <td class="center">
                        ${Number(row.SQM_Per_LM || 0).toFixed(2)}
                    </td>

                    <td class="right">
                        ${Number(row.Total_SQM || 0).toFixed(2)}
                    </td>
                </tr>`;
            });
        });

        rows += `
        <tr class="subTotalRow">
            <td colspan="8" class="right">
                TOTAL SQM (${cat})
            </td>
            <td class="right">
                ${(catTotals[cat] || 0).toFixed(2)}
            </td>
        </tr>`;
    });

    return {

        title: `STEEL PROOFING BOQ - ${record.DRAIEH_CONTRACTING}`,

        filename: "FIRE PROOFING BOQ.pdf",

        html: `
        <table>

    <colgroup>
        <col style="width:8%">
        <col style="width:14%">
        <col style="width:18%">
        <col style="width:10%">
        <col style="width:14%">
        <col style="width:8%">
        <col style="width:12%">
        <col style="width:10%">
        <col style="width:10%">
    </colgroup>


            <thead>

                <tr>
                    <td colspan="9" class="titleRow">
                        STEEL PROOFING BOQ - ${record.DRAIEH_CONTRACTING}
                    </td>
                </tr>

                <tr>
                    <td colspan="9" class="projectRow">
                        PROJECT: ${record.PROJECT || ""}
                    </td>
                </tr>

                <tr class="headerRow">
                    <th style="width:6%;">SI.NO.</th>
                    <th style="width:14%;">FLOOR NAME</th>
                    <th style="width:18%;">SIZE</th>
                    <th style="width:8%;">EXPOSURE</th>
                    <th style="width:14%;">LENGTH / HEIGHT PER STRUCTURE</th>
                    <th style="width:6%;">NOS</th>
                    <th style="width:12%;">TOTAL LENGTH</th>
                    <th style="width:10%;">SQM PER LM</th>
                    <th style="width:12%;">TOTAL SQM</th>
                </tr>

            </thead>

            <tbody>

                ${rows}

            </tbody>

            <tfoot>

                <tr class="totalRow">
                    <td colspan="8" class="right">
                        GRAND TOTAL SQM
                    </td>

                    <td class="right">
                        ${grandTotal.toFixed(2)}
                    </td>
                </tr>

            </tfoot>

        </table>`
    };
}



/* ================================================= */
/* ROUTER — picks the right builder by dropdown       */
/* ================================================= */

function getBuilder(selectValue) {

    const v = (selectValue || "").trim().toUpperCase();

    switch (v) {

        case "SIGNAGES BOQ FORMAT":
            console.log("SIGNAGE PDF");
            return buildSignagePDF;

        case "ROAD MARKING - BOQ":
            console.log("ROAD MARKING PDF");
            return buildRoadMarkingPDF;

        case "BOQ - RM & EPOXY":
            console.log("RM & EPOXY PDF");
            return buildRMEpoxyPDF;

        case "BOQ - PENETRATION":
            console.log("PENETRATION PDF");
            return buildPenetrationPDF;

        case "BOQ - HEAD OF WALL JOINT":
            console.log("HEAD OF WALL PDF");
            return buildHeadOfWallPDF;

        case "BOQ - GRP LINING":
            console.log("GRP LINING PDF");
            return buildGRPLiningPDF;

        case "BOQ - FIRE PROOFING":
            console.log("FIRE PROOFING PDF");
            return buildFireProofingPDF;

        default:
            console.warn("Unknown BOQ Type :", selectValue);
            return buildRoadMarkingPDF;
    }
}
/* ================================================= */
/* MAIN                                              */
/* ================================================= */

ZOHO.embeddedApp.on("PageLoad", async function(data) {

try {

    ZOHO.CRM.UI.Resize({ height: "2000", width: "1000" });

    /* ---- fetch record ---- */
    const recordId = Array.isArray(data.EntityId) ? data.EntityId[0] : data.EntityId;

    const response = await ZOHO.CRM.API.getRecord({
        Entity: "BOQ",
        RecordID: recordId
    });

    const record = response.data[0];
    console.log("Record:", record);

    /* ---- pick builder from dropdown ---- */
    const selectValue = record.Select_subfrom || "";
    const builder     = getBuilder(selectValue);
    const built       = builder(record);

    /* ---- inject HTML ---- */
    document.getElementById("pdfArea").innerHTML = `
        
<div class="content">
    ${built.html}

    <div style="
        width:100%;
        text-align:right;
        page-break-inside:avoid;
        break-inside:avoid;
    ">
        <img class="seal" src="${sealImg}">
    </div>

</div>`;

    /* ---- generate PDF ---- */
    setTimeout(() => {
        html2pdf()
            .set({
                margin: [5, 5, 5, 5],
                filename: built.filename,
                image: { type: "jpeg", quality: 1 },
                html2canvas: {
                    scale: 4,
                    useCORS: true,
                    scrollY: 0
                },
                jsPDF: {
                    unit: "mm",
                    format: "a4",
                    orientation: "portrait"
                },
                pagebreak: {
                    mode: ["css", "legacy"]
                }
            })
            .from(document.getElementById("pdfArea"))
            .save();
    }, 1000);

} catch (error) {
    console.error(error);
    alert("ERROR : " + JSON.stringify(error));
}

});

ZOHO.embeddedApp.init();

</script>

